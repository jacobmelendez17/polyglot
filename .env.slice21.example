# --- Slice 21: production hardening (append to your .env / .env.example) ---
# All optional — the app runs with sensible defaults if these are unset.

# Error tracking (Sentry). Leave DSN blank to disable entirely.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
APP_ENV=development

# Structured logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Rate limiting. Backend: "memory" (default, single node) or "redis" (Upstash).
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_MAX=120          # requests per window per client IP
RATE_LIMIT_WINDOW=60        # seconds
# REDIS_URL=rediss://default:...@...upstash.io:6379   # only for RATE_LIMIT_BACKEND=redis

# Privacy-first analytics (Plausible). Leave the domain blank to ship no analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
